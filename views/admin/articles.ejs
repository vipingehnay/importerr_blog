<%- include('layout/header') %>

<div class="admin-header-row" style="margin-bottom: 2.5rem;">
  <div>
    <h1 class="admin-page-title">Manage Articles</h1>
    <p style="color: var(--text-sub); margin-top: 0.25rem;">Total of <%= articles.length %> articles found in the repository.</p>
  </div>
  <div>
    <a href="/blog/admin/articles/new" class="btn btn-primary" style="padding: 0.75rem 1.5rem; border-radius: 20px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.25rem;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      Create New Article
    </a>
  </div>
</div>

<!-- Filters Bar -->
<div class="card" style="margin-bottom: 2rem; border-radius: 12px;">
  <div class="card-body" style="padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <a href="/blog/admin/articles" class="filter-btn <%= !statusFilter ? 'active' : '' %>" style="border-radius: 20px; font-size: 0.8rem; padding: 0.45rem 1.15rem;">All</a>
      <a href="/blog/admin/articles?status=published" class="filter-btn <%= statusFilter === 'published' ? 'active' : '' %>" style="border-radius: 20px; font-size: 0.8rem; padding: 0.45rem 1.15rem;">Published</a>
      <a href="/blog/admin/articles?status=draft" class="filter-btn <%= statusFilter === 'draft' ? 'active' : '' %>" style="border-radius: 20px; font-size: 0.8rem; padding: 0.45rem 1.15rem;">Drafts</a>
      <a href="/blog/admin/articles?status=scheduled" class="filter-btn <%= statusFilter === 'scheduled' ? 'active' : '' %>" style="border-radius: 20px; font-size: 0.8rem; padding: 0.45rem 1.15rem;">Scheduled</a>
      <a href="/blog/admin/articles?status=archived" class="filter-btn <%= statusFilter === 'archived' ? 'active' : '' %>" style="border-radius: 20px; font-size: 0.8rem; padding: 0.45rem 1.15rem;">Archived</a>
    </div>
    
    <div>
      <form action="/blog/admin/articles" method="GET" style="display: flex; gap: 0.5rem; align-items: center;">
        <% if (statusFilter) { %>
          <input type="hidden" name="status" value="<%= statusFilter %>">
        <% } %>
        <input type="text" name="search" placeholder="Search by title..." value="<%= searchVal || '' %>" class="form-control" style="padding: 0.45rem 1rem; font-size: 0.82rem; width: 200px; border-radius: 20px; background: #FFFFFF; box-shadow: var(--shadow-sm);">
        
        <select name="date" class="form-control" style="padding: 0.45rem 1.75rem 0.45rem 1rem; font-size: 0.82rem; border-radius: 20px; background: #FFFFFF; box-shadow: var(--shadow-sm); border: 1px solid var(--border-light); width: 150px; cursor: pointer; outline: none;">
          <option value="">All dates</option>
          <% availableMonths.forEach(m => { %>
            <option value="<%= m.value %>" <%= dateFilter === m.value ? 'selected' : '' %>><%= m.label %></option>
          <% }) %>
        </select>

        <button type="submit" class="btn btn-secondary" style="padding: 0.45rem 1.15rem; font-size: 0.82rem; border-radius: 20px;">Filter</button>
      </form>
    </div>
  </div>
</div>

<!-- Articles Table -->
<div class="card" style="border-radius: 16px;">
  <div class="card-body" style="padding: 0;">
    <% if (articles.length === 0) { %>
      <div style="padding: 5rem 2rem; text-align: center; color: var(--text-muted);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-muted); margin-bottom: 0.75rem;">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <p style="font-size: 1rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.25rem;">No articles match your selection</p>
        <p style="font-size: 0.85rem; margin-bottom: 1.25rem;">Try clearing your search query or filters to browse the complete library.</p>
        <a href="/blog/admin/articles" class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.5rem 1.25rem; border-radius: 20px;">Clear Filters</a>
      </div>
    <% } else { %>
      <form action="/blog/admin/articles/bulk" method="POST" onsubmit="return confirmBulkAction(this);">
        <div style="padding: 0.85rem 1.25rem; border-bottom: 1px solid var(--border-light); display: flex; align-items: center; gap: 0.5rem; background: #FAF9F6;">
          <select name="action" class="form-control" style="width: 150px; font-size: 0.8rem; border-radius: 20px; padding: 0.35rem 0.75rem; border: 1px solid var(--border-light); height: auto; outline: none; cursor: pointer;" required>
            <option value="">Bulk Actions</option>
            <option value="publish">Publish</option>
            <option value="draft">Move to Draft</option>
            <option value="archive">Archive</option>
            <option value="delete">Delete Selected</option>
          </select>
          <button type="submit" class="btn btn-secondary" style="padding: 0.35rem 1rem; font-size: 0.8rem; border-radius: 20px; font-weight: 700;">Apply</button>
        </div>
        <table class="admin-table">
          <thead>
            <tr>
              <th style="width: 40px; text-align: center; padding-left: 1.25rem;">
                <input type="checkbox" class="select-all-checkbox" style="cursor: pointer; width: 14px; height: 14px;">
              </th>
              <th style="width: 90px; text-align: center;">Media</th>
              <th>Title</th>
              <th>Category</th>
              <th>Author</th>
              <th>Status</th>
              <th>Publish Date</th>
              <th style="text-align: right; width: 320px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% articles.forEach(art => { %>
              <tr>
                <td style="text-align: center; vertical-align: middle; padding-left: 1.25rem;">
                  <input type="checkbox" name="ids" value="<%= art.id %>" class="row-checkbox" style="cursor: pointer; width: 14px; height: 14px;">
                </td>
                <td style="text-align: center; vertical-align: middle;">
                  <img src="<%= art.featuredImage || 'https://images.unsplash.com/photo-1578575437130-527eed3abbec?w=100' %>" alt="<%= art.title %>" style="width: 60px; aspect-ratio: 16/9; object-fit: cover; border-radius: 6px; border: 1px solid var(--border-light); display: inline-block; vertical-align: middle;">
                </td>
                <td style="font-weight: 700; color: var(--text-main); max-width: 280px; line-height: 1.35;">
                  <div style="margin-bottom: 0.25rem;"><%= art.title %></div>
                  <div style="display: inline-flex; gap: 0.25rem; flex-wrap: wrap;">
                    <% if (art.isFeatured) { %>
                      <span style="font-size: 0.65rem; font-weight: 800; text-transform: uppercase; color: var(--color-brand); background: var(--color-brand-light); border: 1px solid rgba(208, 156, 1, 0.15); padding: 0.1rem 0.4rem; border-radius: 10px; letter-spacing: 0.02em;">Featured</span>
                    <% } %>
                    <% if (art.pillarArticle) { %>
                      <span style="font-size: 0.65rem; font-weight: 800; text-transform: uppercase; color: var(--color-blue); background: var(--color-blue-light); border: 1px solid rgba(37, 99, 235, 0.1); padding: 0.1rem 0.4rem; border-radius: 10px; letter-spacing: 0.02em;">Pillar</span>
                    <% } %>
                  </div>
                </td>
                <td style="font-weight: 500;"><%= art.categoryName %></td>
                <td><%= art.authorName %></td>
                <td>
                  <span class="badge badge-<%= art.status %>"><%= art.status %></span>
                </td>
                <td style="font-size: 0.82rem; color: var(--text-muted); font-weight: 500;">
                  <% if (art.status === 'published') { %>
                    <%= new Date(art.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  <% } else if (art.status === 'scheduled') { %>
                    Scheduled: <%= new Date(art.publishedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                  <% } else { %>
                    &mdash;
                  <% } %>
                </td>
                <td style="text-align: right; vertical-align: middle;">
                  <div style="display: inline-flex; gap: 0.25rem; align-items: center; justify-content: flex-end;">
                    <a href="/blog/admin/articles/edit/<%= art.id %>" class="btn btn-secondary" style="padding: 0.4rem 0.75rem; font-size: 0.75rem; border-radius: 6px;">Edit</a>
                    
                    <form action="/blog/admin/articles/duplicate/<%= art.id %>" method="POST" style="display: inline;">
                      <button type="submit" class="btn btn-secondary" style="padding: 0.4rem 0.75rem; font-size: 0.75rem; border-radius: 6px;">Duplicate</button>
                    </form>
                    
                    <% if (art.status === 'published') { %>
                      <a href="/blog/<%= art.slug %>" target="_blank" class="btn btn-secondary" style="padding: 0.4rem 0.75rem; font-size: 0.75rem; border-radius: 6px;">View</a>
                    <% } else { %>
                      <a href="/blog/admin/articles/preview/<%= art.id %>" target="_blank" class="btn btn-secondary" style="padding: 0.4rem 0.75rem; font-size: 0.75rem; border-radius: 6px; color: var(--color-blue); border-color: rgba(37, 99, 235, 0.25); background: rgba(37, 99, 235, 0.02);">Preview</a>
                    <% } %>
                    
                    <form action="/blog/admin/articles/delete/<%= art.id %>" method="POST" style="display: inline;" data-confirm="Are you sure you want to delete this article? This will move it to archived/deleted status.">
                      <button type="submit" class="btn btn-danger" style="padding: 0.4rem 0.75rem; font-size: 0.75rem; border-radius: 6px;">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </form>
    <% } %>
  </div>
</div>

<%- include('layout/footer') %>
