<%- include('layout/header') %>

<div class="admin-header-row" style="margin-bottom: 2.5rem;">
  <div>
    <h1 class="admin-page-title">Manage Categories</h1>
    <p style="color: var(--text-sub); margin-top: 0.25rem;">Group blog articles into main themes, and manage category-level SEO routing.</p>
  </div>
</div>

<div class="editor-layout" style="grid-template-columns: 1fr 380px; gap: 2rem;">
  
  <!-- Categories List (Left Column) -->
  <div class="card" style="border-radius: 16px;">
    <div class="card-header" style="border-top-left-radius: 16px; border-top-right-radius: 16px;">
      <span>Categories List</span>
    </div>
    <div class="card-body" style="padding: 0;">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Slug & Directory</th>
            <th>Description</th>
            <th>Status</th>
            <th style="text-align: right; width: 160px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach(cat => { %>
            <tr>
              <td style="font-weight: 700; color: var(--text-main);"><%= cat.name %></td>
              <td><code style="background: var(--bg-admin); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.8rem; border: 1px solid var(--border-light);">/blog/<%= cat.slug %></code></td>
              <td style="font-size: 0.82rem; color: var(--text-muted); max-width: 250px; line-height: 1.4;"><%= cat.description %></td>
              <td>
                <span class="badge badge-<%= cat.status === 'active' ? 'published' : 'draft' %>"><%= cat.status === 'active' ? 'Active' : 'Archived' %></span>
              </td>
              <td style="text-align: right; vertical-align: middle;">
                <div style="display: inline-flex; gap: 0.35rem; justify-content: flex-end; align-items: center;">
                  <button type="button" class="btn btn-secondary edit-cat-btn" style="padding: 0.4rem 0.75rem; font-size: 0.75rem; border-radius: 6px;" 
                          data-id="<%= cat.id %>"
                          data-name="<%= cat.name %>"
                          data-slug="<%= cat.slug %>"
                          data-desc="<%= cat.description %>"
                          data-status="<%= cat.status %>"
                          data-seotitle="<%= cat.seoTitle || '' %>"
                          data-seodesc="<%= cat.metaDescription || '' %>">
                    Edit
                  </button>
                  <form action="/blog/admin/categories/delete/<%= cat.id %>" method="POST" style="display: inline;" data-confirm="Are you sure you want to delete this category? Current articles will be unassigned.">
                    <button type="submit" class="btn btn-danger" style="padding: 0.4rem 0.75rem; font-size: 0.75rem; border-radius: 6px;">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Create/Edit Form (Right Column Sidebar Card) -->
  <div class="card" style="border-radius: 16px; height: fit-content; position: sticky; top: 100px;">
    <div class="card-header" style="border-top-left-radius: 16px; border-top-right-radius: 16px;">
      <span id="form-header-title">Create Category</span>
    </div>
    <div class="card-body" style="padding: 1.5rem;">
      <form action="/blog/admin/categories/create" method="POST" id="category-form">
        <input type="hidden" name="id" id="cat-id">
        
        <div class="form-group">
          <label for="cat-name">Category Name</label>
          <input type="text" id="cat-name" name="name" class="form-control" placeholder="e.g. Sourcing Guides" required style="border-radius: 8px;">
        </div>
        
        <div class="form-group">
          <label for="cat-slug">URL Slug</label>
          <input type="text" id="cat-slug" name="slug" class="form-control" placeholder="sourcing-guides" required style="border-radius: 8px; background: #FAFAFA;">
        </div>
        
        <div class="form-group">
          <label for="cat-desc">Description</label>
          <textarea id="cat-desc" name="description" class="form-control" placeholder="Brief summary of category focus area..." rows="3" required style="border-radius: 8px; line-height: 1.45;"></textarea>
        </div>
        
        <div class="form-group">
          <label for="cat-status">Status</label>
          <select id="cat-status" name="status" class="form-control" style="border-radius: 8px;">
            <option value="active">Active</option>
            <option value="archived">Archived / Hidden</option>
          </select>
        </div>
        
        <div style="border-top: 1px solid var(--border-light); margin-top: 1.5rem; padding-top: 1.25rem;">
          <h4 style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; margin-bottom: 1rem; color: var(--text-muted); letter-spacing: 0.05em;">SEO Overrides (Optional)</h4>
          
          <div class="form-group">
            <label for="cat-seotitle">SEO Browser Title</label>
            <input type="text" id="cat-seotitle" name="seoTitle" class="form-control" placeholder="Custom page title tag" style="border-radius: 8px;">
          </div>
          
          <div class="form-group" style="margin-bottom: 0;">
            <label for="cat-seodesc">Meta Description</label>
            <textarea id="cat-seodesc" name="metaDescription" class="form-control" placeholder="Custom snippet search description..." rows="2" style="border-radius: 8px; line-height: 1.4;"></textarea>
          </div>
        </div>

        <div style="margin-top: 1.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
          <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem; border-radius: 20px;">
            Save Category
          </button>
          <button type="button" id="reset-form-btn" class="btn btn-secondary" style="width: 100%; padding: 0.75rem; border-radius: 20px; display: none; justify-content: center; align-items: center;">
            Clear & Create New
          </button>
        </div>
      </form>
    </div>
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const editBtns = document.querySelectorAll('.edit-cat-btn');
    const form = document.getElementById('category-form');
    const formTitle = document.getElementById('form-header-title');
    const resetBtn = document.getElementById('reset-form-btn');
    
    const inputId = document.getElementById('cat-id');
    const inputName = document.getElementById('cat-name');
    const inputSlug = document.getElementById('cat-slug');
    const inputDesc = document.getElementById('cat-desc');
    const inputStatus = document.getElementById('cat-status');
    const inputSeoTitle = document.getElementById('cat-seotitle');
    const inputSeoDesc = document.getElementById('cat-seodesc');

    // Name-to-Slug auto filler
    inputName.addEventListener('input', () => {
      if (!inputId.value) { // Only auto-fill on creation
        inputSlug.value = inputName.value
          .toLowerCase()
          .trim()
          .replace(/[^a-z0-9\s-]/g, '')
          .replace(/\s+/g, '-');
      }
    });

    editBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Change form action to update
        form.action = `/blog/admin/categories/update/${btn.dataset.id}`;
        formTitle.textContent = `Edit Category: ${btn.dataset.name}`;
        resetBtn.style.display = 'inline-flex';
        
        // Populate inputs
        inputId.value = btn.dataset.id;
        inputName.value = btn.dataset.name;
        inputSlug.value = btn.dataset.slug;
        inputDesc.value = btn.dataset.desc;
        inputStatus.value = btn.dataset.status;
        inputSeoTitle.value = btn.dataset.seotitle;
        inputSeoDesc.value = btn.dataset.seodesc;
        
        // Smooth scroll to form
        window.scrollTo({
          top: form.getBoundingClientRect().top + window.scrollY - 120,
          behavior: 'smooth'
        });
      });
    });

    resetBtn.addEventListener('click', () => {
      form.action = '/blog/admin/categories/create';
      formTitle.textContent = 'Create Category';
      resetBtn.style.display = 'none';
      form.reset();
      inputId.value = '';
    });
  });
</script>

<%- include('layout/footer') %>
