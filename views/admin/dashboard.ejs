<%- include('layout/header') %>

<div class="admin-header-row" style="margin-bottom: 2.5rem;">
  <div>
    <h1 class="admin-page-title">Blog Dashboard</h1>
    <p style="color: var(--text-sub); margin-top: 0.25rem;">Overview of Importerr Blog content library, traffic metrics, and SEO health.</p>
  </div>
  <div>
    <a href="/blog/admin/articles/new" class="btn btn-primary" style="padding: 0.75rem 1.5rem; border-radius: 20px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.25rem;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      Create New Article
    </a>
  </div>
</div>

<!-- Stats Grid -->
<div class="stats-grid">
  <div class="stat-card" style="border-top: 3px solid var(--color-blue);">
    <span class="stat-label">Total Articles</span>
    <span class="stat-value"><%= stats.total %></span>
  </div>
  <div class="stat-card" style="border-top: 3px solid var(--badge-pub-txt);">
    <span class="stat-label">Published</span>
    <span class="stat-value"><%= stats.published %></span>
  </div>
  <div class="stat-card" style="border-top: 3px solid var(--text-muted);">
    <span class="stat-label">Drafts</span>
    <span class="stat-value"><%= stats.drafts %></span>
  </div>
  <div class="stat-card" style="border-top: 3px solid var(--badge-sched-txt);">
    <span class="stat-label">Scheduled</span>
    <span class="stat-value"><%= stats.scheduled %></span>
  </div>
</div>

<div class="editor-layout" style="grid-template-columns: 1fr 340px; gap: 2rem;">
  
  <!-- Left Side: Recent Articles List -->
  <div class="editor-main-col" style="gap: 0;">
    <div class="card" style="border-radius: 16px; margin-bottom: 0;">
      <div class="card-header" style="border-top-left-radius: 16px; border-top-right-radius: 16px;">
        <span>Recently Edited Articles</span>
        <a href="/blog/admin/articles" style="font-size: 0.82rem; font-weight: 700; color: var(--color-brand); text-decoration: underline;">View All Articles &rarr;</a>
      </div>
      <div class="card-body" style="padding: 0;">
        <% if (recentArticles.length === 0) { %>
          <div style="padding: 4rem 2rem; text-align: center; color: var(--text-muted);">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-muted); margin-bottom: 0.75rem;">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            <p style="font-weight: 600; font-size: 0.95rem; color: var(--text-main); margin-bottom: 0.25rem;">No articles written yet</p>
            <p style="font-size: 0.82rem;">Create your first sourcing guide to launch the blog platform.</p>
          </div>
        <% } else { %>
          <table class="admin-table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Author</th>
                <th>Status</th>
                <th>Date Modified</th>
                <th style="text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% recentArticles.forEach(art => { %>
                <tr>
                  <td style="font-weight: 700; color: var(--text-main); max-width: 320px;">
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                      <img src="<%= art.featuredImage || 'https://images.unsplash.com/photo-1578575437130-527eed3abbec?w=100' %>" alt="<%= art.title %>" style="width: 50px; aspect-ratio: 16/10; object-fit: cover; border-radius: 6px; border: 1px solid var(--border-light); flex-shrink: 0;">
                      <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        <%= art.title %>
                      </div>
                    </div>
                  </td>
                  <td style="font-weight: 500;"><%= art.categoryName %></td>
                  <td><%= art.authorName %></td>
                  <td>
                    <span class="badge badge-<%= art.status %>"><%= art.status %></span>
                  </td>
                  <td style="font-size: 0.82rem; color: var(--text-muted); font-weight: 500;">
                    <%= new Date(art.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; gap: 0.35rem;">
                      <a href="/blog/admin/articles/edit/<%= art.id %>" class="btn btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.75rem; border-radius: 6px;">Edit</a>
                      <a href="/blog/<%= art.slug %>" target="_blank" class="btn btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.75rem; border-radius: 6px;">View</a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Right Side: Quick Action Center & Tips -->
  <div class="editor-sidebar-col">
    
    <!-- Quick Action Desk -->
    <div class="card" style="border-radius: 16px;">
      <div class="card-header" style="border-top-left-radius: 16px; border-top-right-radius: 16px;">
        <span>Quick Actions</span>
      </div>
      <div class="card-body" style="padding: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem;">
        <a href="/blog/admin/articles/new" class="btn btn-secondary" style="justify-content: flex-start; text-align: left; width: 100%; border-radius: 10px; padding: 0.75rem 1rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-brand);"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
          <div style="display: flex; flex-direction: column;">
            <span style="font-weight: 700; font-size: 0.85rem; color: var(--text-main);">Write New Article</span>
            <span style="font-size: 0.7rem; color: var(--text-muted); font-weight: 500;">Draft a search-optimized guide</span>
          </div>
        </a>
        <a href="/blog/admin/media" class="btn btn-secondary" style="justify-content: flex-start; text-align: left; width: 100%; border-radius: 10px; padding: 0.75rem 1rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-blue);"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <div style="display: flex; flex-direction: column;">
            <span style="font-weight: 700; font-size: 0.85rem; color: var(--text-main);">Upload Media Assets</span>
            <span style="font-size: 0.7rem; color: var(--text-muted); font-weight: 500;">Compress images to WebP format</span>
          </div>
        </a>
        <a href="/blog/admin/categories" class="btn btn-secondary" style="justify-content: flex-start; text-align: left; width: 100%; border-radius: 10px; padding: 0.75rem 1rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #10B981;"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
          <div style="display: flex; flex-direction: column;">
            <span style="font-weight: 700; font-size: 0.85rem; color: var(--text-main);">Manage Categories</span>
            <span style="font-size: 0.7rem; color: var(--text-muted); font-weight: 500;">Organize and group article topics</span>
          </div>
        </a>
        <a href="/blog/admin/redirects" class="btn btn-secondary" style="justify-content: flex-start; text-align: left; width: 100%; border-radius: 10px; padding: 0.75rem 1rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #EF4444;"><path d="M16 3h5v5"></path><path d="M4 20L21 3"></path><path d="M21 16v5h-5"></path><path d="M15 15l6 6"></path><path d="M4 4l5 5"></path></svg>
          <div style="display: flex; flex-direction: column;">
            <span style="font-weight: 700; font-size: 0.85rem; color: var(--text-main);">URL Redirect Rules</span>
            <span style="font-size: 0.7rem; color: var(--text-muted); font-weight: 500;">Set up 301 paths to preserve SEO</span>
          </div>
        </a>
      </div>
    </div>
    
    <!-- Compliance Tips -->
    <div class="card" style="border-radius: 16px;">
      <div class="card-header" style="border-top-left-radius: 16px; border-top-right-radius: 16px;">
        <span>Content Compliance Guide</span>
      </div>
      <div class="card-body" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">
        
        <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
          <div style="background: var(--color-brand-light); border: 1px solid var(--badge-sched-border); color: var(--color-brand); width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-weight: 800; font-size: 0.75rem;">1</div>
          <div style="display: flex; flex-direction: column; gap: 0.15rem;">
            <span style="font-weight: 800; font-size: 0.85rem; color: var(--text-main);">AI & Engine Readability</span>
            <span style="font-size: 0.78rem; color: var(--text-sub); line-height: 1.35;">Structure guides with clean Heading hierarchies (H2/H3). Keep paragraphs short to boost search engine index accessibility.</span>
          </div>
        </div>

        <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
          <div style="background: rgba(37, 99, 235, 0.05); border: 1px solid rgba(37, 99, 235, 0.15); color: var(--color-blue); width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-weight: 800; font-size: 0.75rem;">2</div>
          <div style="display: flex; flex-direction: column; gap: 0.15rem;">
            <span style="font-weight: 800; font-size: 0.85rem; color: var(--text-main);">Structured FAQ Schema</span>
            <span style="font-size: 0.78rem; color: var(--text-sub); line-height: 1.35;">The engine automatically writes JSON-LD metadata markup on page headers once you configure takeaways and FAQ blocks.</span>
          </div>
        </div>

        <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
          <div style="background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.15); color: #10B981; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-weight: 800; font-size: 0.75rem;">3</div>
          <div style="display: flex; flex-direction: column; gap: 0.15rem;">
            <span style="font-weight: 800; font-size: 0.85rem; color: var(--text-main);">WebP Compression</span>
            <span style="font-size: 0.78rem; color: var(--text-sub); line-height: 1.35;">Uploading images via Media Library triggers sharp compilation to WebP formats. Remember to add Alt descriptions to cards.</span>
          </div>
        </div>

      </div>
    </div>
    
  </div>
  
</div>

<%- include('layout/footer') %>
