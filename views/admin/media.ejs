<%- include('layout/header') %>

<div class="admin-header-row" style="margin-bottom: 2.5rem;">
  <div>
    <h1 class="admin-page-title">Media Library</h1>
    <p style="color: var(--text-sub); margin-top: 0.25rem;">Upload PNG or JPG graphics; the engine automatically compresses and crops them to WebP dimensions.</p>
  </div>
  <div>
    <button type="button" id="upload-toggle-btn" class="btn btn-primary" style="padding: 0.75rem 1.5rem; border-radius: 20px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.25rem;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
      Upload New Image
    </button>
  </div>
</div>

<!-- Upload Zone Card (Initially Hidden) -->
<div class="card" id="upload-card" style="display: none; margin-bottom: 2rem; border-radius: 16px; transition: var(--transition-smooth);">
  <div class="card-header" style="border-top-left-radius: 16px; border-top-right-radius: 16px;">
    <span>Upload Image Resources</span>
  </div>
  <div class="card-body" style="padding: 2rem;">
    <form action="/blog/admin/media/upload" method="POST" enctype="multipart/form-data">
      <div class="upload-dropzone" onclick="document.getElementById('file-input').click();" style="margin-bottom: 1.5rem;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 0.75rem; display: inline-block;">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
        <p style="font-weight: 700; font-size: 0.95rem; color: var(--text-main); margin-bottom: 0.25rem;">Drag and drop your image, or click to browse</p>
        <p style="font-size: 0.78rem; color: var(--text-muted);">Supports PNG, JPG, JPEG, and WebP format</p>
        <input type="file" id="file-input" name="image" style="display: none;" onchange="this.form.submit();" accept="image/*">
      </div>
      <div class="form-group" style="margin-bottom: 0;">
        <label for="altText">Image Alt Text (Crucial for SEO Image Search rank)</label>
        <input type="text" id="altText" name="altText" class="form-control" placeholder="e.g. Sourcing consultant negotiating wholesale order details at supplier counter" style="border-radius: 8px;">
      </div>
    </form>
  </div>
</div>

<!-- Search Media Filter Bar -->
<div class="card" style="margin-bottom: 2rem; border-radius: 12px;">
  <div class="card-body" style="padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <form action="/blog/admin/media" method="GET" style="display: flex; gap: 0.5rem; width: 100%; max-width: 580px; align-items: center;">
      <input type="text" name="search" placeholder="Search assets by alt description..." value="<%= searchVal || '' %>" class="form-control" style="background: #FFFFFF; border-radius: 20px; padding: 0.45rem 1.15rem; font-size: 0.85rem; flex-grow: 1;">
      
      <select name="date" class="form-control" style="padding: 0.45rem 1.75rem 0.45rem 1rem; font-size: 0.82rem; border-radius: 20px; background: #FFFFFF; box-shadow: var(--shadow-sm); border: 1px solid var(--border-light); width: 150px; cursor: pointer; outline: none;">
        <option value="">All dates</option>
        <% availableMonths.forEach(m => { %>
          <option value="<%= m.value %>" <%= dateFilter === m.value ? 'selected' : '' %>><%= m.label %></option>
        <% }) %>
      </select>

      <button type="submit" class="btn btn-secondary" style="border-radius: 20px; padding: 0.45rem 1.15rem; font-size: 0.85rem;">Filter</button>
    </form>
    <div style="font-size: 0.82rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
      <%= media.length %> images in repository
    </div>
  </div>
</div>

<!-- Media Library Grid -->
<% if (media.length === 0) { %>
  <div class="card" style="border-radius: 16px;">
    <div class="card-body" style="padding: 5rem 2rem; text-align: center; color: var(--text-muted);">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-muted); margin-bottom: 0.75rem;">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <circle cx="8.5" cy="8.5" r="1.5"></circle>
        <polyline points="21 15 16 10 5 21"></polyline>
      </svg>
      <p style="font-size: 1rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.25rem;">No media files found</p>
      <p style="font-size: 0.85rem; margin-bottom: 1.25rem;">Start by uploading raw PNG/JPG image assets to include in guides.</p>
      <a href="/blog/admin/media" class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.5rem 1.25rem; border-radius: 20px;">View All Assets</a>
    </div>
  </div>
<% } else { %>
  <form action="/blog/admin/media/bulk" method="POST" onsubmit="return confirmBulkAction(this);">
    <div style="margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; background: #FAF9F6; padding: 0.85rem 1.25rem; border-radius: 12px; border: 1px solid var(--border-light);">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <label style="display: flex; align-items: center; gap: 0.35rem; font-size: 0.82rem; font-weight: 700; cursor: pointer; color: var(--text-main); margin: 0; user-select: none;">
          <input type="checkbox" class="select-all-checkbox" style="cursor: pointer; width: 14px; height: 14px;">
          Select All Assets
        </label>
        <input type="hidden" name="action" value="delete">
        <button type="submit" class="btn btn-danger" style="padding: 0.35rem 1rem; font-size: 0.8rem; border-radius: 20px; font-weight: 700; background: var(--color-red); color: white; border: none; display: flex; align-items: center; gap: 0.25rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
          Delete Selected Assets
        </button>
      </div>
    </div>
    
    <div class="media-grid">
      <% media.forEach(img => { %>
        <div class="media-card" style="border-radius: 16px; position: relative;">
          <!-- Checkbox overlay -->
          <div style="position: absolute; top: 10px; left: 10px; z-index: 10; background: rgba(255,255,255,0.9); padding: 4px; border-radius: 6px; box-shadow: var(--shadow-sm); display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-light);">
            <input type="checkbox" name="ids" value="<%= img.id %>" class="row-checkbox" style="cursor: pointer; width: 15px; height: 15px; margin: 0;">
          </div>
          
          <div class="media-img-wrap" style="aspect-ratio: 1.6;">
            <img src="<%= img.url %>" alt="<%= img.altText %>" loading="lazy">
          </div>
          
          <div class="media-details" style="padding: 1.25rem;">
            <div class="media-filename" title="<%= img.filename %>" style="font-weight: 700; font-size: 0.85rem; margin-bottom: 0.5rem;"><%= img.filename %></div>
            
            <div style="display: flex; flex-direction: column; gap: 0.35rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem; margin-bottom: 0.75rem;">
              <div style="display: flex; justify-content: space-between; font-size: 0.75rem;">
                <span style="color: var(--text-muted); font-weight: 500;">Format:</span>
                <span style="font-weight: 700; color: var(--badge-pub-txt); background: var(--badge-pub-bg); padding: 0.05rem 0.35rem; border-radius: 4px; font-size: 0.65rem; border: 1px solid var(--badge-pub-border);">WEB P</span>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 0.75rem;">
                <span style="color: var(--text-muted); font-weight: 500;">Dimensions:</span>
                <span style="font-weight: 700; color: var(--text-main); font-family: monospace;"><%= img.width %> &times; <%= img.height %> px</span>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 0.75rem;">
                <span style="color: var(--text-muted); font-weight: 500;">Compressed Size:</span>
                <span style="font-weight: 700; color: var(--text-main); font-family: monospace;"><%= (img.sizeBytes / 1024).toFixed(1) %> KB</span>
              </div>
            </div>
            
            <div style="font-size: 0.75rem; line-height: 1.35; color: var(--text-sub); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 32px;" title="<%= img.altText || 'Alt description missing' %>">
              <strong style="font-weight: 700; color: var(--text-main);">Alt:</strong> <%= img.altText || 'No Alt description set. Edit article to ensure metadata indexes.' %>
            </div>
            
            <div class="media-actions" style="margin-top: 0.75rem; padding-top: 0.75rem;">
              <button type="button" class="media-action-btn copy-url-btn" data-url="<%= img.url %>" style="color: var(--color-blue); font-weight: 800; font-size: 0.8rem; display: flex; align-items: center; gap: 0.25rem;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
                Copy Image URL
              </button>
              <form action="/blog/admin/media/delete/<%= img.id %>" method="POST" style="display: inline;" data-confirm="Are you sure you want to delete this image? Check that no articles are currently using this URL.">
                <button type="submit" class="media-action-btn delete" style="color: var(--color-red); font-weight: 800; font-size: 0.8rem; display: flex; align-items: center; gap: 0.25rem;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                  Delete
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </form>
<% } %>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Toggle upload area
    const uploadBtn = document.getElementById('upload-toggle-btn');
    const uploadCard = document.getElementById('upload-card');
    
    if (uploadBtn && uploadCard) {
      uploadBtn.addEventListener('click', () => {
        const isHidden = uploadCard.style.display === 'none';
        uploadCard.style.display = isHidden ? 'block' : 'none';
        uploadBtn.textContent = isHidden ? 'Close Upload Panel' : 'Upload New Image';
      });
    }

    // Copy URL action helper
    const copyBtns = document.querySelectorAll('.copy-url-btn');
    copyBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.dataset.url;
        // Resolve absolute URL
        const absoluteUrl = url.startsWith('http') ? url : window.location.origin + url;
        
        navigator.clipboard.writeText(absoluteUrl).then(() => {
          const originalText = btn.innerHTML;
          btn.innerHTML = `
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Copied!
          `;
          setTimeout(() => {
            btn.innerHTML = originalText;
          }, 2000);
        }).catch(err => {
          console.error('Could not copy url:', err);
        });
      });
    });
  });
</script>

<%- include('layout/footer') %>
