<%- include('layout/header') %>

<div class="admin-header-row" style="margin-bottom: 2.5rem;">
  <div>
    <h1 class="admin-page-title">Newsletter Subscribers</h1>
    <p style="color: var(--text-sub); margin-top: 0.25rem;">Monitor email newsletter subscriptions and export leads.</p>
  </div>
</div>

<!-- Subscribers Stats & Search Filter Bar -->
<div class="card" style="margin-bottom: 2rem; border-radius: 12px;">
  <div class="card-body" style="padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <form action="/blog/admin/subscribers" method="GET" style="display: flex; gap: 0.5rem; width: 100%; max-width: 540px; align-items: center;">
      <input type="text" name="search" placeholder="Search by email address..." value="<%= searchVal || '' %>" class="form-control" style="background: #FFFFFF; border-radius: 20px; padding: 0.45rem 1.15rem; font-size: 0.85rem; flex-grow: 1;">
      
      <select name="date" class="form-control" style="padding: 0.45rem 1.75rem 0.45rem 1rem; font-size: 0.82rem; border-radius: 20px; background: #FFFFFF; box-shadow: var(--shadow-sm); border: 1px solid var(--border-light); width: 150px; cursor: pointer; outline: none;">
        <option value="">All dates</option>
        <% availableMonths.forEach(m => { %>
          <option value="<%= m.value %>" <%= dateFilter === m.value ? 'selected' : '' %>><%= m.label %></option>
        <% }) %>
      </select>

      <button type="submit" class="btn btn-secondary" style="border-radius: 20px; padding: 0.45rem 1.15rem; font-size: 0.85rem;">Filter</button>
    </form>
    <div style="font-size: 0.82rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
      <%= subscribers.length %> Active Subscribers
    </div>
  </div>
</div>

<!-- Subscribers List Table -->
<div class="card" style="border-radius: 16px;">
  <div class="card-body" style="padding: 0;">
    <% if (subscribers.length === 0) { %>
      <div style="padding: 5rem 2rem; text-align: center; color: var(--text-muted);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-muted); margin-bottom: 0.75rem;">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <p style="font-size: 1rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.25rem;">No subscribers found</p>
        <p style="font-size: 0.85rem; margin-bottom: 1.25rem;">Email signups collected from public landing widgets will display here.</p>
        <a href="/blog/admin/subscribers" class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.5rem 1.25rem; border-radius: 20px;">Clear Search</a>
      </div>
    <% } else { %>
      <form action="/blog/admin/subscribers/bulk" method="POST" onsubmit="return confirmBulkAction(this);">
        <div style="padding: 0.85rem 1.25rem; border-bottom: 1px solid var(--border-light); display: flex; align-items: center; gap: 0.5rem; background: #FAF9F6;">
          <select name="action" class="form-control" style="width: 150px; font-size: 0.8rem; border-radius: 20px; padding: 0.35rem 0.75rem; border: 1px solid var(--border-light); height: auto; outline: none; cursor: pointer;" required>
            <option value="">Bulk Actions</option>
            <option value="delete">Delete Selected</option>
          </select>
          <button type="submit" class="btn btn-secondary" style="padding: 0.35rem 1rem; font-size: 0.8rem; border-radius: 20px; font-weight: 700;">Apply</button>
        </div>
        <table class="admin-table">
          <thead>
            <tr>
              <th style="width: 40px; text-align: center; padding-left: 1.25rem;">
                <input type="checkbox" class="select-all-checkbox" style="cursor: pointer; width: 14px; height: 14px;">
              </th>
              <th>Email Address</th>
              <th>Subscription Date</th>
              <th>Status</th>
              <th style="text-align: right; width: 140px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% subscribers.forEach(sub => { %>
              <tr>
                <td style="text-align: center; vertical-align: middle; padding-left: 1.25rem;">
                  <input type="checkbox" name="ids" value="<%= sub.id %>" class="row-checkbox" style="cursor: pointer; width: 14px; height: 14px;">
                </td>
                <td style="font-weight: 700; color: var(--text-main); font-family: monospace; font-size: 0.9rem;">
                  <%= sub.email %>
                </td>
                <td style="font-size: 0.85rem; color: var(--text-muted); font-weight: 500;">
                  <%= new Date(sub.subscribedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                </td>
                <td>
                  <span class="badge badge-published">Subscribed</span>
                </td>
                <td style="text-align: right; vertical-align: middle;">
                  <form action="/blog/admin/subscribers/delete/<%= sub.id %>" method="POST" style="display: inline;" data-confirm="Are you sure you want to remove this subscriber? They will be unsubscribed from the listing.">
                    <button type="submit" class="btn btn-danger" style="padding: 0.4rem 0.75rem; font-size: 0.75rem; border-radius: 6px;">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </form>
    <% } %>
  </div>
</div>

<%- include('layout/footer') %>
