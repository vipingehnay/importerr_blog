<%- include('../layout/header') %>

<!-- JSON-LD Structured Data Schema Markup -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": "<%= currentUrl %>#article",
      "isPartOf": {
        "@type": "WebPage",
        "@id": "<%= currentUrl %>",
        "url": "<%= currentUrl %>",
        "name": "<%= seo.title || title %>"
      },
      "headline": "<%= title %>",
      "description": "<%= seo.description || excerpt %>",
      "image": "<%= featuredImage %>",
      "datePublished": "<%= publishedAt %>",
      "dateModified": "<%= updatedAt %>",
      "author": {
        "@type": "Person",
        "name": "<%= authorName %>",
        "url": "<%= baseUrl %>/blog/author/<%= authorSlug %>"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Importerr Sourcing Partner",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.importerr.com/static/media/comimport.3838f084f6791c3ea895.png"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "<%= currentUrl %>"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "<%= currentUrl %>#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "<%= baseUrl %>/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": "<%= baseUrl %>/blog"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "<%= categoryName %>",
          "item": "<%= baseUrl %>/blog/category/<%= category %>"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "<%= title %>",
          "item": "<%= currentUrl %>"
        }
      ]
    }
    <% if (faq && faq.length > 0) { %>,
    {
      "@type": "FAQPage",
      "mainEntity": [
        <% faq.forEach((item, idx) => { %>
          {
            "@type": "Question",
            "name": "<%= item.q %>",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "<%= item.a.replace(/"/g, '\\"') %>"
            }
          }<%= idx < faq.length - 1 ? ',' : '' %>
        <% }) %>
      ]
    }
    <% } %>
  ]
}
</script>

<main class="section-wrapper post-layout-wrapper">
  
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs-nav">
    <a href="/">Home</a>
    <span>&rarr;</span>
    <a href="/blog">Blog</a>
    <span>&rarr;</span>
    <a href="/blog/category/<%= category %>"><%= categoryName %></a>
    <span>&rarr;</span>
    <span style="color: var(--text-muted);"><%= title %></span>
  </nav>

  <!-- Post Header -->
  <header class="post-header">
    <span class="meta-tag"><%= categoryName %></span>
    <h1><%= title %></h1>
    
    <div class="post-meta-details">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <img src="<%= authorPhoto %>" alt="<%= authorName %>" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;">
        <span class="author-name">By <a href="/blog/author/<%= authorSlug %>"><%= authorName %></a></span>
      </div>
      <div class="post-date-read">
        Published: <%= formattedPublishDate %>
        <% if (formattedUpdateDate && formattedUpdateDate !== formattedPublishDate) { %>
          &bull; Updated: <%= formattedUpdateDate %>
        <% } %>
        &bull; <%= readingTime %>
      </div>
    </div>
  </header>

  <!-- Featured Image -->
  <div class="post-featured-image-wrap">
    <img src="<%= featuredImage %>" alt="<%= title %>" class="post-featured-image" loading="eager">
  </div>

  <!-- Content & Sidebar Grid -->
  <div class="post-read-grid">
    
    <!-- Sidebar: Table of Contents (Desktop) -->
    <aside class="sidebar-toc-col">
      <div class="toc-title">Table of Contents</div>
      <ul class="toc-list" id="desktop-toc-list">
        <!-- Injected via JavaScript -->
      </ul>
    </aside>

    <!-- Main Content Reader -->
    <article style="max-width: 780px; width: 100%;">
      
      <!-- Collapsible TOC for Mobile -->
      <div class="mobile-toc">
        <div class="mobile-toc-header">
          <span class="mobile-toc-title">Table of Contents</span>
          <span class="mobile-toc-toggle-icon" style="transition: transform 0.2s ease; display: inline-block;">&#9662;</span>
        </div>
        <div class="mobile-toc-content">
          <ul class="toc-list" id="mobile-toc-list" style="margin-bottom: 0;">
            <!-- Injected via JavaScript -->
          </ul>
        </div>
      </div>

      <!-- Article Excerpt Box -->
      <div class="article-excerpt-intro" style="font-size: 1.25rem; font-weight: 500; line-height: 1.6; color: var(--text-sub); border-left: 3px solid var(--color-brand); padding-left: 1.25rem; margin-bottom: 2rem;">
        <%= excerpt %>
      </div>

      <!-- Key Takeaways Section -->
      <% if (keyTakeaways && keyTakeaways.length > 0) { %>
        <div class="key-takeaways-block">
          <div class="takeaway-header">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Key Takeaways
          </div>
          <ul class="takeaway-list">
            <% keyTakeaways.forEach(pt => { %>
              <li><%= pt %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <!-- Dynamic Article Content -->
      <div class="article-content-body">
        <%- content %>
      </div>

      <!-- FAQ Section (FAQ Block Accordions) -->
      <% if (faq && faq.length > 0) { %>
        <section class="faq-section-wrapper">
          <h2 style="margin: 0 0 0.5rem 0;">Frequently Asked Questions</h2>
          <p style="color: var(--text-sub); font-size: 0.95rem;">Get answers to common queries about <%= title %>.</p>
          <div class="faq-grid">
            <% faq.forEach(item => { %>
              <div class="faq-item">
                <button class="faq-question-btn">
                  <%= item.q %>
                  <span class="faq-icon">+</span>
                </button>
                <div class="faq-answer-panel">
                  <p><%= item.a %></p>
                </div>
              </div>
            <% }) %>
          </div>
        </section>
      <% } %>

      <!-- Configurable Sourcing CTA Block -->
      <% if (cta) { %>
        <section class="article-cta-block">
          <h3><%= cta.title %></h3>
          <p><%= cta.subtitle %></p>
          <a href="<%= cta.buttonUrl %>" class="cta-submit-btn">
            <%= cta.buttonText %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </section>
      <% } %>

      <!-- Author Bio Section -->
      <section class="author-bio-section">
        <img src="<%= authorPhoto %>" alt="<%= authorName %>" class="author-bio-avatar">
        <div class="author-bio-details">
          <span class="author-bio-title">About the Author</span>
          <h4 class="author-bio-name"><%= authorName %></h4>
          <p class="author-bio-text"><%= authorBio %></p>
          <div class="author-social-links">
            <% if (authorSocial && authorSocial.linkedin) { %>
              <a href="<%= authorSocial.linkedin %>" target="_blank">LinkedIn &rarr;</a>
            <% } %>
            <% if (authorSocial && authorSocial.twitter) { %>
              <a href="<%= authorSocial.twitter %>" target="_blank">Twitter &rarr;</a>
            <% } %>
            <a href="/blog/author/<%= authorSlug %>">All Articles &rarr;</a>
          </div>
        </div>
      </section>

      <!-- Comments Section -->
      <section id="comments-section" style="margin-top: 5rem; border-top: 1px solid var(--border-light); padding-top: 4rem;">
        <h2 style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 2.5rem; color: var(--text-main); font-family: 'Inter Tight', sans-serif;">Reader Responses (<%= comments.length %>)</h2>

        <!-- Alert messages -->
        <% if (commentPending) { %>
          <div style="background: var(--badge-pub-bg); border: 1px solid var(--badge-pub-border); color: var(--badge-pub-txt); font-weight: 700; padding: 1rem 1.25rem; border-radius: 12px; margin-bottom: 2.5rem; font-size: 0.9rem; display: flex; align-items: center; gap: 0.5rem; box-shadow: var(--shadow-sm);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Thank you! Your comment response has been submitted and is awaiting approval.
          </div>
        <% } %>
        <% if (commentError) { %>
          <div style="background: rgba(220, 38, 38, 0.05); border: 1px solid rgba(220, 38, 38, 0.15); color: var(--color-red); font-weight: 700; padding: 1rem 1.25rem; border-radius: 12px; margin-bottom: 2.5rem; font-size: 0.9rem; display: flex; align-items: center; gap: 0.5rem; box-shadow: var(--shadow-sm);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            Error: All comment form fields are required.
          </div>
        <% } %>

        <!-- Comments List -->
        <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 4rem;">
          <% if (comments.length === 0) { %>
            <p style="color: var(--text-muted); font-size: 1rem; font-style: italic;">No comments posted yet. Be the first to share your sourcing feedback!</p>
          <% } else { %>
            <% comments.forEach(c => { %>
              <div class="comment-card">
                <!-- User Avatar Badge with initial letter -->
                <div class="comment-avatar">
                  <%= c.authorName.charAt(0) %>
                </div>
                <div class="comment-details">
                  <div class="comment-author-row">
                    <span class="comment-author-name"><%= c.authorName %></span>
                    <span class="comment-date">
                      <%= new Date(c.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                    </span>
                  </div>
                  <p class="comment-body-text"><%= c.content %></p>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>

        <!-- Comment Response Form -->
        <div class="comment-form-card">
          <h3 class="comment-form-title">Leave a Response</h3>
          <p class="comment-form-subtitle">Your email address will not be published. Required fields are marked *</p>

          <form action="/blog/<%= slug %>/comment" method="POST" style="display: flex; flex-direction: column; gap: 1.5rem;">
            <div class="comment-form-row">
              <div class="comment-form-group">
                <label for="comment-author">Your Name *</label>
                <input type="text" id="comment-author" name="authorName" class="comment-field-input" placeholder="e.g. Rahul Sharma" required>
              </div>
              <div class="comment-form-group">
                <label for="comment-email">Your Email *</label>
                <input type="email" id="comment-email" name="authorEmail" class="comment-field-input" placeholder="e.g. rahul@company.com" required>
              </div>
            </div>
            
            <div class="comment-form-group">
              <label for="comment-content">Response Content *</label>
              <textarea id="comment-content" name="content" class="comment-field-textarea" placeholder="Share your sourcing query, factory experiences, or thoughts on this guide..." rows="6" required></textarea>
            </div>

            <div style="margin-top: 0.5rem;">
              <button type="submit" class="comment-submit-button">
                Post Response Comment
              </button>
            </div>
          </form>
        </div>
      </section>

    </article>

    <!-- Sidebar: Social Share Buttons (Desktop) -->
    <aside class="share-sidebar-col">
      <span class="share-title">Share Article</span>
      <button class="share-btn-wrap" data-share="whatsapp" title="Share on WhatsApp">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.713-1.458L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.967C16.59 1.973 14.121.95 11.5.952c-5.438 0-9.863 4.371-9.867 9.8-.001 1.943.511 3.829 1.48 5.53l-.987 3.604 3.709-.974zm9.906-6.611c-.269-.134-1.593-.787-1.839-.877-.247-.09-.427-.135-.607.135-.18.27-.697.877-.854 1.057-.158.18-.315.203-.585.068-.27-.135-1.137-.42-2.167-1.337-.802-.716-1.343-1.6-1.5-1.87-.158-.271-.017-.417.118-.552.122-.122.27-.315.405-.472.135-.158.18-.27.27-.45.09-.18.045-.337-.023-.472-.068-.135-.607-1.462-.832-2.002-.218-.528-.44-.456-.607-.464-.158-.008-.338-.01-.518-.01-.18 0-.472.068-.72.338-.247.27-1.936 1.89-1.936 4.613s1.98 5.355 2.25 5.715c.27.36 3.896 5.95 9.438 8.34 1.318.568 2.348.908 3.15 1.163 1.325.421 2.533.361 3.486.219.96-.145 2.593-.601 2.955-1.611.362-1.01.362-1.874.253-2.053-.109-.18-.405-.27-.675-.405z"/></svg>
      </button>
      <button class="share-btn-wrap" data-share="twitter" title="Share on X (Twitter)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </button>
      <button class="share-btn-wrap" data-share="linkedin" title="Share on LinkedIn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0h.003z"/></svg>
      </button>
      <button class="share-btn-wrap" data-share="facebook" title="Share on Facebook">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </button>
      <button class="share-btn-wrap" data-share="copy" title="Copy Article URL">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
      </button>
    </aside>

  </div>
</main>

<!-- Mobile Fixed Share Bar -->
<div class="mobile-share-bar">
  <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Share:</span>
  <button class="share-btn-wrap" data-share="whatsapp" style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.713-1.458L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.967C16.59 1.973 14.121.95 11.5.952c-5.438 0-9.863 4.371-9.867 9.8-.001 1.943.511 3.829 1.48 5.53l-.987 3.604 3.709-.974zm9.906-6.611c-.269-.134-1.593-.787-1.839-.877-.247-.09-.427-.135-.607.135-.18.27-.697.877-.854 1.057-.158.18-.315.203-.585.068-.27-.135-1.137-.42-2.167-1.337-.802-.716-1.343-1.6-1.5-1.87-.158-.271-.017-.417.118-.552.122-.122.27-.315.405-.472.135-.158.18-.27.27-.45.09-.18.045-.337-.023-.472-.068-.135-.607-1.462-.832-2.002-.218-.528-.44-.456-.607-.464-.158-.008-.338-.01-.518-.01-.18 0-.472.068-.72.338-.247.27-1.936 1.89-1.936 4.613s1.98 5.355 2.25 5.715c.27.36 3.896 5.95 9.438 8.34 1.318.568 2.348.908 3.15 1.163 1.325.421 2.533.361 3.486.219.96-.145 2.593-.601 2.955-1.611.362-1.01.362-1.874.253-2.053-.109-.18-.405-.27-.675-.405z"/></svg>
