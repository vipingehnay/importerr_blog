  </button>
</div>

<!-- Related Articles Section -->
<% if (relatedArticles && relatedArticles.length > 0) { %>
  <section class="related-posts-section">
    <div class="section-wrapper">
      <h2 style="font-size: 1.75rem; margin-bottom: 2rem; letter-spacing: -0.02em;">Related Articles</h2>
      <div class="article-grid">
        <% relatedArticles.forEach(art => { %>
          <article class="article-card">
            <div class="article-img-wrap">
              <a href="/blog/<%= art.slug %>">
                <img src="<%= art.featuredImage %>" alt="<%= art.title %>" class="article-img" loading="lazy">
              </a>
            </div>
            <div class="article-body">
              <span class="meta-tag"><%= art.categoryName %></span>
              <h3 class="article-title">
                <a href="/blog/<%= art.slug %>"><%= art.title %></a>
              </h3>
              <p class="article-excerpt"><%= art.excerpt %></p>
              <div class="card-author-row">
                <img src="<%= art.authorPhoto %>" alt="<%= art.authorName %>" class="card-author-img">
                <div class="card-author-meta">
                  <span class="card-author-name">By <a href="/blog/author/<%= art.authorSlug %>"><%= art.authorName %></a></span>
                  <div class="post-date-read">
                    <%= art.formattedPublishDate %> &bull; <%= art.readingTime %>
                  </div>
                </div>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </section>
<% } %>

<!-- Recommended Articles Section -->
<% if (recommendedArticles && recommendedArticles.length > 0) { %>
  <section class="related-posts-section" style="border-top: none; padding-top: 0; background: rgba(17,17,17,0.01);">
    <div class="section-wrapper">
      <h2 style="font-size: 1.75rem; margin-bottom: 2rem; letter-spacing: -0.02em;">You May Also Like</h2>
      <div class="article-grid">
        <% recommendedArticles.forEach(art => { %>
          <article class="article-card">
            <div class="article-img-wrap">
              <a href="/blog/<%= art.slug %>">
                <img src="<%= art.featuredImage %>" alt="<%= art.title %>" class="article-img" loading="lazy">
              </a>
            </div>
            <div class="article-body">
              <span class="meta-tag"><%= art.categoryName %></span>
              <h3 class="article-title">
                <a href="/blog/<%= art.slug %>"><%= art.title %></a>
              </h3>
              <p class="article-excerpt"><%= art.excerpt %></p>
              <div class="card-author-row">
                <img src="<%= art.authorPhoto %>" alt="<%= art.authorName %>" class="card-author-img">
                <div class="card-author-meta">
                  <span class="card-author-name">By <a href="/blog/author/<%= art.authorSlug %>"><%= art.authorName %></a></span>
                  <div class="post-date-read">
                    <%= art.formattedPublishDate %> &bull; <%= art.readingTime %>
                  </div>
                </div>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </section>
<% } %>

<%- include('../layout/footer') %>
